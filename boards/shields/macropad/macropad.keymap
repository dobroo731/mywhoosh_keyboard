#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        td_1_6: tap_dance_1_6 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp N1>, <&kp N6>;
        };
        td_2_7: tap_dance_2_7 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp N2>, <&kp N7>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_bt_clr {
            timeout-ms = <100>;
            key-positions = <14 15>;
            bindings = <&bt BT_CLR>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp K        &kp I        &kp A       &kp D
                &kp U        &td_1_6      &td_2_7     &kp N3
                &kp N4       &kp N5       &kp C_VOL_DN &kp C_VOL_UP
                &kp C_PREV   &kp C_NEXT   &kp C_PP     &kp LG(PSCRN)
            >;
        };
    };
};
