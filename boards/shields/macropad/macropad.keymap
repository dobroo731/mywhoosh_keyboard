#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_bt_clr {
            timeout-ms = <100>;
            key-positions = <14 15>;
            bindings = <&bt BT_CLR>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp K        &kp I        &kp A       &kp D
                &kp U        &kp N1       &kp N2      &kp N3
                &kp N4       &kp N5       &kp C_VOL_DN &kp C_VOL_UP
                &kp C_PREV   &kp C_NEXT   &kp C_PP     &kp LG(PSCRN)
            >;
        };
    };
};
