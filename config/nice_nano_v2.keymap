#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp LG(PSCRN) &kp C_VOL_DN &kp C_VOL_UP
                &kp C_PREV    &kp C_NEXT   &kp C_PP
                &kp N1        &kp N2       &kp N3
                &kp N4        &kp N5       &kp N6
                &kp N7        &kp K        &kp I
                &kp A         &kp D        &kp U
            >;
        };
    };
};
